# Read-only mainnet Solana RPC endpoint for get_position and finalize_intent
# market snapshots. Save APY uses its pinned public endpoint and needs no key.
# The real value may contain a provider API key: set it only in your local
# environment or external MCP host config, and never commit that value.
SOLFRONTIER_RPC_URL=https://your-solana-rpc.example/?api-key=YOUR_API_KEY

# Optional public Jupiter quote API base for get_quote. The default is the
# value below; override only for a compatible proxy/staging endpoint.
# Even though no key is expected, the server never logs or returns this URL.
SOLFRONTIER_JUPITER_BASE_URL=https://api.jup.ag
